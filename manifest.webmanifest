{
  "name": "InfluenceFlow CRM",
  "short_name": "InfluenceFlow",
  "description": "Influencer CRM for agencies — influencers, brands, campaigns and calendar.",
  "id": "/influenceflow-crm/",
  "start_url": "/influenceflow-crm/#/app",
  "scope": "/influenceflow-crm/",
  "display": "standalone",
  "background_color": "#1e1b24",
  "theme_color": "#1e1b24",
  "icons": [
    { "src": "/influenceflow-crm/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/influenceflow-crm/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/influenceflow-crm/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/influenceflow-crm/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add influencer", "url": "/influenceflow-crm/#/app/influencers?new=1" },
    { "name": "Calendar", "url": "/influenceflow-crm/#/app/calendar" }
  ]
}
